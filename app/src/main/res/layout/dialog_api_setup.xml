<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="sans-serif-black"
            android:text="@string/api_title"
            android:textColor="@color/primary"
            android:textSize="24sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:text="@string/api_subtitle"
            android:textAlignment="center"
            android:textColor="@color/textHint"
            android:textSize="12sp" />

        <!-- ========== AI BRAIN PROVIDER ========== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/ai_provider"
            android:textColor="@color/primary"
            android:textSize="14sp" />

        <!-- AI Provider Selection -->
        <RadioGroup
            android:id="@+id/rgAIProvider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbGemini"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="@color/geminiColor"
                android:text="@string/gemini"
                android:textColor="@color/textSecondary"
                android:textSize="12sp" />

            <RadioButton
                android:id="@+id/rbOpenAI"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="@color/openaiColor"
                android:text="@string/openai"
                android:textColor="@color/textSecondary"
                android:textSize="12sp" />

            <RadioButton
                android:id="@+id/rbCustomAI"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="@color/statusBlue"
                android:text="@string/custom_endpoint"
                android:textColor="@color/textSecondary"
                android:textSize="10sp" />
        </RadioGroup>

        <!-- AI API Key -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilAIKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="@string/api_key_label"
            app:boxBackgroundColor="@color/surface"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:endIconMode="password_toggle"
            app:hintTextColor="@color/primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAIKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:textColor="@android:color/white"
                android:textColorHint="@color/textHint" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- AI Custom URL -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilAIURL"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="@string/api_url_label"
            android:visibility="gone"
            app:boxBackgroundColor="@color/surface"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:hintTextColor="@color/primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAIURL"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/default_gemini_url"
                android:textColor="@android:color/white"
                android:textColorHint="@color/textHint" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- AI Model -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilAIModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:hint="@string/model_label"
            app:boxBackgroundColor="@color/surface"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:hintTextColor="@color/primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAIModel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="gemini-2.0-flash"
                android:textColor="@android:color/white"
                android:textColorHint="@color/textHint" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Test AI Connection Button -->
        <Button
            android:id="@+id/btnTestAI"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_button_outline"
            android:text="@string/test_connection"
            android:textAllCaps="false"
            android:textColor="@color/textSecondary"
            android:textSize="13sp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="24dp"
            android:background="@color/divider" />

        <!-- ========== VOICE PROVIDER ========== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/voice_provider"
            android:textColor="@color/elevenlabsColor"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/rgVoiceProvider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbElevenLabs"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="@color/elevenlabsColor"
                android:text="@string/elevenlabs"
                android:textColor="@color/textSecondary"
                android:textSize="12sp" />

            <RadioButton
                android:id="@+id/rbDeviceTTS"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="@color/statusGreen"
                android:text="@string/browser_tts"
                android:textColor="@color/textSecondary"
                android:textSize="11sp" />
        </RadioGroup>

        <!-- Voice API Key -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilVoiceKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:hint="@string/api_key_label"
            app:boxBackgroundColor="@color/surface"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:endIconMode="password_toggle"
            app:hintTextColor="@color/elevenlabsColor">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etVoiceKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:textColor="@android:color/white"
                android:textColorHint="@color/textHint" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Voice ID -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilVoiceID"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:hint="@string/voice_id_label"
            app:boxBackgroundColor="@color/surface"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:hintTextColor="@color/elevenlabsColor">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etVoiceID"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="pNInz6obpgDQGcFmaJgB"
                android:textColor="@android:color/white"
                android:textColorHint="@color/textHint" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="24dp"
            android:background="@color/divider" />

        <!-- ========== SEARCH PROVIDER ========== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/search_provider"
            android:textColor="@color/serperColor"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/rgSearchProvider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbSerper"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="@color/serperColor"
                android:text="@string/serper"
                android:textColor="@color/textSecondary"
                android:textSize="12sp" />

            <RadioButton
                android:id="@+id/rbDirectGoogle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="@color/statusGreen"
                android:text="@string/direct_google"
                android:textColor="@color/textSecondary"
                android:textSize="11sp" />
        </RadioGroup>

        <!-- Search API Key -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilSearchKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:hint="@string/api_key_label"
            app:boxBackgroundColor="@color/surface"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:endIconMode="password_toggle"
            app:hintTextColor="@color/serperColor">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSearchKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:textColor="@android:color/white"
                android:textColorHint="@color/textHint" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Save Button -->
        <Button
            android:id="@+id/btnSaveKeys"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_gradient_red"
            android:fontFamily="sans-serif-medium"
            android:text="@string/save_keys"
            android:textColor="@android:color/white"
            android:textSize="16sp" />

        <!-- Skip Link -->
        <TextView
            android:id="@+id/tvSkip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:padding="8dp"
            android:text="@string/skip"
            android:textColor="@color/textHint"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>